# ---------------------------------------------------------------------------
# Database (required) - Postgres connection string, e.g. Neon / Supabase / local
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/society_tracker?schema=public"

# Direct (non-pooled) connection, used only for migrations. On a plain Postgres
# set it to the same value as DATABASE_URL; on Neon use the "-pooler"-less host.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/society_tracker?schema=public"

# ---------------------------------------------------------------------------
# Auth (required) - secret used to sign session JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Email (optional) - Resend free tier. If omitted, emails are logged to the
# console instead of being sent, so the app still runs end to end.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Society Tracker <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Photo uploads (optional) - Vercel Blob. If omitted, photos are written to
# public/uploads/ which works for local development only.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Public base URL, used to build links inside outgoing emails.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seed credentials (used by `npm run db:seed` only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@society.com"
SEED_ADMIN_PASSWORD="Admin@123"
